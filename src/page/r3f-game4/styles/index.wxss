.r3f-game4 {
  position: absolute;
  width: 100vw;
  height: 100vh;
}

.r3f-game4 .canvas-box {
  position: absolute;
  width: 100vw;
  height: 100vh;
}

.r3f-game4 .canvas-box canvas {
  width: 100%;
  height: 100%;
}

.r3f-game4 .button {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 50%;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  transform: translate3d(-50%, -50%, 0);
  border: 2px solid white;
}

.r3f-game4 .beg {
  position: absolute;
  z-index: 4;
  top: 80vh;
  right: 4vw;
  width: 6.5vw;
  height: 12vh;
  border-radius: 2vw;
  background-color: rgba(0, 0, 0, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
}

.r3f-game4 .beg .beg-img {
  background-image: url("../../../../public/beg2.png");
  background-size: 100% 100%;
  width: 90%;
  height: 90%;
}
